@model WebApp_Desafio_FrontEnd.ViewModels.ChamadoViewModel

@{
    ViewData["Title"] = "Chamados";
}

<div class="panel panel-primary mt-3">
    <div class="panel-heading">
        <strong>Filtros</strong>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <label asp-for="Assunto"></label>
                <input class="form-control" asp-for="Assunto" />
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <label asp-for="Solicitante"></label>
                <input class="form-control" asp-for="Solicitante" />
            </div>
            <div class="col-sm-12 col-md-3 col-lg-3">
                <label asp-for="Departamento"></label>
                <select class="form-control" asp-for="IdDepartamento">
                    <option value=""></option>
                </select>
            </div>
        </div>
    </div>
    <div class="panel-footer">
        <div class="row">
            <div class="col-md-12 text-right">
                <button id="buttonLimpar" class="btn btn-default">Limpar</button>
                <button id="buttonConsultar" class="btn btn-primary">Consultar</button>
            </div>
        </div>
    </div>
</div>

<div class="panel panel-primary">
    <div class="panel-heading">
        <strong>Registros</strong>
    </div>
    <div class="panel-body">
        <div class="row mt-3">
            <div class="col-lg-6 text-left">
                <button type="button" class="btn btn-outline btn-primary" id="btnRelatorio">
                    <i class="fa fa-file-pdf-o" style="margin-right: 5px;"></i>Relatório
                </button>
            </div>
            <div class="col-lg-6 text-right">
                <button type="button" class="btn btn-outline btn-primary" id="btnAdicionar">
                    <i class="fa fa-plus"></i> Adicionar
                </button>
                <button type="button" class="btn btn-outline btn-primary" id="btnEditar">
                    <i class="fa fa-pencil"></i> Editar
                </button>
                <button type="button" class="btn btn-outline btn-danger" id="btnExcluir">
                    <i class="fa fa-trash"></i> Excluir
                </button>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-lg-12" style="overflow-x:auto;">
                <table class="table table-striped table-bordered table-hover" id="dataTables-Chamados">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.ID)</th>
                            <th>@Html.DisplayNameFor(model => model.Assunto)</th>
                            <th>@Html.DisplayNameFor(model => model.Solicitante)</th>
                            <th>@Html.DisplayNameFor(model => model.Departamento)</th>
                            <th class="text-center">@Html.DisplayNameFor(model => model.DataAbertura)</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section styles
{
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
}

@section scripts
{
    <!-- SweetAlert2 -->
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>

    <script src="~/js/Chamados/Listar.js" asp-append-version="true"></script>
}
